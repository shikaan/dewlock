# swaylock(1) completion

_swaylock()
{
  local cur prev short long
  _get_comp_words_by_ref -n : cur prev

  short=(
    -c
    -d
    -f
    -r
    -h
    -v
  )

  long=(
    --config
    --debug
    --daemonize
    --ready-fd
    --help
    --version
  )

  case $prev in
    -c|--config)
      COMPREPLY=($(compgen -f -- "$cur"))
      return
      ;;
  esac

  if [[ $cur == --* ]]; then
    COMPREPLY=($(compgen -W "${long[*]}" -- "$cur"))
  else
    COMPREPLY=($(compgen -W "${short[*]}" -- "$cur"))
    COMPREPLY+=($(compgen -W "${long[*]}" -- "$cur"))
  fi

} &&
complete -F _swaylock swaylock
