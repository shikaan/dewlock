#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Overridable so CI can stamp the commit that produced the package;
# local builds fall back to the generic marker.
SHA ?= deb

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- BUILD_TYPE=release-deb VERSION=v$(DEB_VERSION_UPSTREAM) SHA=$(SHA)

override_dh_auto_install:
	$(MAKE) install BUILD_TYPE=release-deb PREFIX=/usr DESTDIR=$(CURDIR)/debian/dewlock
